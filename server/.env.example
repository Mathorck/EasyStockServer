# Copy to .env and edit. EASYSTOCK_DB is built by docker-compose.yml from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=change-me
# Address phones use to reach the server (written into QR codes).
EASYSTOCK_PUBLIC_URL=https://stock.example.org
# Optional: SHA-256 fingerprint of a self-signed certificate.
EASYSTOCK_CERT_FINGERPRINT=
EASYSTOCK_LOG_LEVEL=Information
# Optional: comma-separated IPs or CIDRs of your reverse proxy (e.g. 172.18.0.0/16).
EASYSTOCK_TRUSTED_PROXIES=
# Optional: minutes between background cleanups of expired invites, resets, promotions and sessions (default 60).
EASYSTOCK_CLEANUP_INTERVAL_MINUTES=
